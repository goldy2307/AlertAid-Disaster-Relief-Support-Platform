# AlertAid Environment Configuration Template
# Copy this file to .env and configure with your actual values

# ==============================================
# DATABASE CONFIGURATION
# ==============================================

# MySQL Database Connection (Default for local development)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/alertaid_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root
SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver
HIBERNATE_DIALECT=org.hibernate.dialect.MySQLDialect

# PostgreSQL Database Connection (Alternative - for Docker deployment)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/alertaid
# SPRING_DATASOURCE_USERNAME=alertaid
# SPRING_DATASOURCE_PASSWORD=alertaid
# SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
# HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# For Docker Compose (use service name 'db' as host)
# SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/alertaid

# ==============================================
# SECURITY CONFIGURATION
# ==============================================

# JWT Secret (Base64 encoded, minimum 32 bytes)
# Generate a strong secret using: openssl rand -base64 32
APP_JWT_SECRET=111c2b5887e48ed931fc42d5fbaf1fa996d85bf270382164fdde777fb2440ac2c835bfc632a9cc7b26b1f98e72eb303c5931f1fc7616fe8877f21a9820cccdf9

# JWT Token Expiration (in milliseconds)
# Default: 86400000 (24 hours)
APP_JWT_EXPIRATION_MS=86400000

# ==============================================
# SERVER CONFIGURATION
# ==============================================

# Server Port
SERVER_PORT=8080

# Spring Profile (dev, prod, test)
SPRING_PROFILES_ACTIVE=dev

# ==============================================
# DATABASE CREDENTIALS (for Docker Compose)
# ==============================================

# MySQL Database Configuration (for local setup)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=alertaid_db
MYSQL_USER=alertaid
MYSQL_PASSWORD=alertaid

# PostgreSQL Container Configuration (for Docker deployment)
POSTGRES_DB=alertaid
POSTGRES_USER=alertaid
POSTGRES_PASSWORD=alertaid

# ==============================================
# LOGGING CONFIGURATION
# ==============================================

# Log Level (DEBUG, INFO, WARN, ERROR)
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_ALERTAID=INFO

# ==============================================
# EXTERNAL SERVICES (if applicable)
# ==============================================

# Email Service Configuration (if implemented)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password

# SMS Service Configuration (if implemented)
# SMS_API_KEY=your-sms-api-key
# SMS_API_URL=https://api.sms-provider.com

# Weather API Configuration (if implemented)
# WEATHER_API_KEY=your-weather-api-key
# WEATHER_API_URL=https://api.openweathermap.org

# Payment Gateway (Razorpay)
PAYMENT_RAZORPAY_KEY_ID=rzp_test_yourKeyId
PAYMENT_RAZORPAY_KEY_SECRET=rzp_test_yourSecret

# ==============================================
# EMAIL / NOTIFICATIONS
# ==============================================

# SMTP settings (fill with your provider or service like SendGrid)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=alertaid.help@gmail.com
MAIL_PASSWORD=ujlbxpsvtkkgvzaa
MAIL_PROTOCOL=smtp
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_STARTTLS_REQUIRED=true

# Report notification controls
ALERTAID_NOTIFICATIONS_EMAIL_ENABLED=true
ALERTAID_NOTIFICATIONS_FROM=alertaid.help@gmail.com
ALERTAID_NOTIFICATIONS_REPORT_SUBJECT=New AlertAid report submitted 
ALERTAID_NOTIFICATIONS_BATCH_SIZE=50

# ==============================================
# FRONTEND CONFIGURATION
# ==============================================

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080

# ==============================================
# PRODUCTION SECURITY NOTES
# ==============================================

# 1. Always use strong, unique passwords
# 2. Generate APP_JWT_SECRET using: openssl rand -base64 32
# 3. Use environment-specific values
# 4. Never commit .env files to version control
# 5. Regularly rotate secrets and passwords
# 6. Use HTTPS in production
# 7. Consider using managed database services in production

# ==============================================
# QUICK SETUP COMMANDS
# ==============================================

# For MySQL (Local Development):
# 1. Copy this file: cp .env.example .env
# 2. Generate JWT secret: openssl rand -base64 32
# 3. Replace APP_JWT_SECRET value above
# 4. Create MySQL database: CREATE DATABASE alertaid_db;
# 5. Run: cd backend/Alertaid && ./mvnw spring-boot:run

# For PostgreSQL (Docker Deployment):
# 1. Copy this file: cp .env.example .env
# 2. Generate JWT secret: openssl rand -base64 32
# 3. Replace APP_JWT_SECRET value above
# 4. Uncomment PostgreSQL settings above
# 5. Run: docker-compose up -d
