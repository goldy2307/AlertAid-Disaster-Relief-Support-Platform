@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

:root {
  --landing-bg: #fafbfc;
  --landing-surface: #ffffff;
  --landing-surface-soft: #fef3ef;
  --landing-muted: #666666;
  --landing-text: #1a1a1a;
  --landing-primary: #FF3B30;
  --landing-secondary: #FF6F00;
  --landing-gradient: linear-gradient(135deg, #FF3B30 0%, #FF6F00 100%);
  --landing-border: rgba(26, 26, 26, 0.08);
  --landing-shadow-soft: 0 20px 45px rgba(17, 24, 39, 0.15);
}

html[data-theme="dark"] {
  --landing-bg: #121212;
  --landing-surface: #1f1f1f;
  --landing-surface-soft: #2a1f1c;
  --landing-muted: #d1d1d1;
  --landing-text: #f5f5f5;
  --landing-primary: #ff6f00;
  --landing-secondary: #ff3b30;
  --landing-gradient: linear-gradient(135deg, #ff6f00 0%, #ff3b30 100%);
  --landing-border: rgba(255, 255, 255, 0.15);
  --landing-shadow-soft: 0 20px 45px rgba(0, 0, 0, 0.55);
}

body.landing-palette {
  background: var(--landing-bg) !important;
  color: var(--landing-text);
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif !important;
  line-height: 1.6;
}

body.landing-palette a {
  color: var(--landing-primary);
  transition: color 0.3s ease;
}

body.landing-palette a:hover {
  color: var(--landing-secondary);
}

body.landing-palette nav,
body.landing-palette header,
body.landing-palette .top-bar,
body.landing-palette .app-header,
body.landing-palette .page-header,
body.landing-palette .dashboard-header {
  background: rgba(255, 255, 255, 0.95) !important;
  color: var(--landing-text) !important;
  border-radius: 18px;
  border: 1px solid var(--landing-border);
  box-shadow: var(--landing-shadow-soft);
  backdrop-filter: blur(10px);
}

body.landing-palette .nav-brand,
body.landing-palette .brand,
body.landing-palette header h1,
body.landing-palette .logo-text {
  color: var(--landing-primary) !important;
  font-weight: 700;
}

body.landing-palette .nav-brand img {
  display: none !important;
}

body.landing-palette nav a,
body.landing-palette header a {
  color: var(--landing-text) !important;
  font-weight: 500;
}

body.landing-palette .weather-widget {
  background: linear-gradient(135deg, #4A90E2, #357ABD) !important;
  color: #ffffff !important;
  border-radius: 16px;
  padding: 12px 20px;
  box-shadow: 0 12px 30px rgba(74, 144, 226, 0.35);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

body.landing-palette .weather-widget i {
  color: #ffffff !important;
}

body.landing-palette .sidebar {
  background: linear-gradient(180deg, rgba(255, 86, 33, 0.98) 0%, rgba(255, 86, 33, 0.96) 32%, #ffffff 32%, #ffffff 100%) !important;
  color: var(--landing-text) !important;
  box-shadow: var(--landing-shadow-soft);
  border-right: 1px solid var(--landing-border);
  padding-top: 110px;
  padding-bottom: 40px;
  overflow: hidden;
}

body.landing-palette .sidebar a {
  color: var(--landing-text) !important;
  font-weight: 600;
  padding: 12px 32px;
  display: flex;
  align-items: center;
  gap: 12px;
  border-radius: 0 20px 20px 0;
  transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
}

body.landing-palette .sidebar a i {
  width: 22px;
  color: var(--landing-primary);
  flex-shrink: 0;
  text-align: center;
}

body.landing-palette .sidebar a:hover {
  background: rgba(255, 59, 48, 0.12) !important;
  color: var(--landing-primary) !important;
  transform: translateX(6px);
}

body.landing-palette .sidebar .closebtn {
  color: #ffffff !important;
  top: 24px !important;
  right: 24px !important;
  width: 42px;
  height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.25);
  font-size: 1.5rem !important;
  transition: background 0.2s ease;
}

body.landing-palette .sidebar .closebtn:hover {
  background: rgba(0, 0, 0, 0.45);
}

body.landing-palette .openbtn {
  width: 48px;
  height: 48px;
  border-radius: 16px;
  background: #ffffff;
  border: none;
  box-shadow: 0 18px 32px rgba(15, 23, 42, 0.12);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  padding: 0;
  font-size: 0;
  position: relative;
  overflow: hidden;
}

body.landing-palette .openbtn::before,
body.landing-palette .openbtn::after,
body.landing-palette .openbtn .openbtn-line {
  content: '';
  position: absolute;
  left: 50%;
  width: 22px;
  height: 2px;
  border-radius: 999px;
  background: linear-gradient(90deg, #ff3b30, #ff8700);
  transform: translateX(-50%);
}

body.landing-palette .openbtn::before { top: 16px; }
body.landing-palette .openbtn .openbtn-line { top: 50%; transform: translate(-50%, -50%); }
body.landing-palette .openbtn::after { bottom: 16px; }

body.landing-palette .openbtn > * {
  opacity: 0;
}

body.landing-palette .openbtn:focus-visible {
  outline: 3px solid rgba(255, 59, 48, 0.4);
  outline-offset: 3px;
}

body.landing-palette .openbtn:hover {
  transform: translateY(-2px);
  box-shadow: 0 22px 36px rgba(255, 111, 0, 0.4);
}

body.landing-palette .closebtn,
body.landing-palette .profile-btn,
body.landing-palette .icon-btn {
  color: var(--landing-primary) !important;
}

body.landing-palette .card,
body.landing-palette .stat-card,
body.landing-palette .info-card,
body.landing-palette .data-card,
body.landing-palette .table-card,
body.landing-palette .dashboard-card,
body.landing-palette .content-card,
body.landing-palette .summary-card,
body.landing-palette .report-card,
body.landing-palette .form-card,
body.landing-palette .glass-card,
body.landing-palette .panel,
body.landing-palette .detail-card,
body.landing-palette .module-card,
body.landing-palette .volunteer-card,
body.landing-palette .task-card {
  background: var(--landing-surface) !important;
  color: var(--landing-text) !important;
  border: 1px solid var(--landing-border) !important;
  border-radius: 18px !important;
  box-shadow: var(--landing-shadow-soft);
  backdrop-filter: none !important;
}

body.landing-palette .card p,
body.landing-palette .stat-card p,
body.landing-palette .info-card p,
body.landing-palette .data-card p,
body.landing-palette .detail-card p,
body.landing-palette .volunteer-card p,
body.landing-palette .table-card p {
  color: var(--landing-muted) !important;
}

body.landing-palette .card i,
body.landing-palette .stat-icon,
body.landing-palette .card .fa,
body.landing-palette .card .fas,
body.landing-palette .card .far {
  color: var(--landing-primary) !important;
}

body.landing-palette section,
body.landing-palette main,
body.landing-palette .page-content {
  background: transparent !important;
}

body.landing-palette input,
body.landing-palette select,
body.landing-palette textarea,
body.landing-palette .input,
body.landing-palette .form-control {
  background: var(--landing-surface) !important;
  color: var(--landing-text) !important;
  border: 1px solid var(--landing-border) !important;
  border-radius: 12px !important;
  padding: 12px 14px;
  box-shadow: 0 6px 18px rgba(15, 23, 42, 0.08);
  transition: border 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}

body.landing-palette input:focus,
body.landing-palette select:focus,
body.landing-palette textarea:focus,
body.landing-palette .form-control:focus {
  border-color: var(--landing-primary) !important;
  box-shadow: 0 0 0 3px rgba(255, 59, 48, 0.2);
  outline: none;
}

body.landing-palette input::placeholder,
body.landing-palette textarea::placeholder,
body.landing-palette .form-control::placeholder {
  color: rgba(26, 26, 26, 0.6) !important;
}

html[data-theme="dark"] body.landing-palette input,
html[data-theme="dark"] body.landing-palette select,
html[data-theme="dark"] body.landing-palette textarea,
html[data-theme="dark"] body.landing-palette .input,
html[data-theme="dark"] body.landing-palette .form-control {
  background: rgba(26, 26, 26, 0.85) !important;
  border: 1px solid rgba(255, 255, 255, 0.25) !important;
  color: #f8f8f8 !important;
  box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.04), 0 12px 28px rgba(0, 0, 0, 0.65);
}

html[data-theme="dark"] body.landing-palette input::placeholder,
html[data-theme="dark"] body.landing-palette textarea::placeholder,
html[data-theme="dark"] body.landing-palette .form-control::placeholder {
  color: rgba(255, 255, 255, 0.65) !important;
}

body.landing-palette label,
body.landing-palette .form-label,
body.landing-palette .field-label,
body.landing-palette .form-section label,
body.landing-palette .form-section h4,
body.landing-palette [class*="label-text"] {
  color: var(--landing-text) !important;
  font-weight: 600;
  text-shadow: none !important;
}

body.landing-palette .volunteer-card {
  border-left: 6px solid rgba(255, 59, 48, 0.85) !important;
  background: linear-gradient(135deg, rgba(255, 59, 48, 0.05), rgba(255, 111, 0, 0.08)) !important;
}

body.landing-palette .badge,
body.landing-palette .status-chip,
body.landing-palette .tag,
body.landing-palette .pill,
body.landing-palette .label {
  background: var(--landing-surface-soft) !important;
  color: var(--landing-primary) !important;
  border: 1px solid rgba(255, 59, 48, 0.25) !important;
  border-radius: 999px;
  padding: 4px 12px;
  font-weight: 600;
}

body.landing-palette button.submit,
body.landing-palette button[type="submit"],
body.landing-palette .submit,
body.landing-palette .primary-btn,
body.landing-palette .action-button,
body.landing-palette .cta-button,
body.landing-palette .btn-primary,
body.landing-palette .main-btn,
body.landing-palette .accent-btn,
body.landing-palette .form-actions button,
body.landing-palette .card button,
body.landing-palette .volunteer-card button,
body.landing-palette .table-card button,
body.landing-palette .status-actions button,
body.landing-palette .modal button.primary {
  background: var(--landing-gradient) !important;
  color: #ffffff !important;
  border: none !important;
  border-radius: 14px !important;
  padding: 12px 20px;
  font-weight: 600;
  box-shadow: 0 12px 25px rgba(255, 59, 48, 0.3);
  cursor: pointer;
}

body.landing-palette button.submit:hover,
body.landing-palette button[type="submit"]:hover,
body.landing-palette .primary-btn:hover,
body.landing-palette .action-button:hover,
body.landing-palette .cta-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 18px 30px rgba(255, 59, 48, 0.35);
}

body.landing-palette table {
  background: var(--landing-surface);
  color: var(--landing-text);
  width: 100%;
  border-collapse: separate !important;
  border-spacing: 0;
  border-radius: 18px;
  overflow: hidden;
  box-shadow: var(--landing-shadow-soft);
}

body.landing-palette th {
  background: var(--landing-gradient);
  color: #ffffff;
  font-weight: 600;
}

body.landing-palette td {
  color: var(--landing-text);
  border-bottom: 1px solid rgba(26, 26, 26, 0.06);
}

body.landing-palette tr:nth-child(even) td {
  background: var(--landing-surface-soft);
}

body.landing-palette footer {
  background: #1f1f1f;
  color: #ffffff !important;
  border-radius: 18px;
  padding: 30px;
  box-shadow: var(--landing-shadow-soft);
  margin-top: 40px;
}

body.landing-palette footer a {
  color: #f8f9fa;
}

body.landing-palette .modal,
body.landing-palette .dialog,
body.landing-palette .popup {
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(4px);
}

body.landing-palette .modal-content,
body.landing-palette .dialog-content,
body.landing-palette .popup-content {
  background: var(--landing-surface);
  color: var(--landing-text);
  border-radius: 18px;
  box-shadow: var(--landing-shadow-soft);
  border: 1px solid var(--landing-border);
}

body.landing-palette .status-positive,
body.landing-palette .success,
body.landing-palette .tag-success {
  background: rgba(40, 167, 69, 0.1) !important;
  color: #28a745 !important;
  border-color: rgba(40, 167, 69, 0.3) !important;
}

body.landing-palette .status-warning,
body.landing-palette .tag-warning {
  background: rgba(255, 193, 7, 0.15) !important;
  color: #b45309 !important;
  border-color: rgba(255, 193, 7, 0.35) !important;
}

body.landing-palette .status-danger,
body.landing-palette .tag-danger {
  background: rgba(255, 59, 48, 0.12) !important;
  color: var(--landing-primary) !important;
  border-color: rgba(255, 59, 48, 0.35) !important;
}

body.landing-palette hr,
body.landing-palette .divider {
  border-color: rgba(26, 26, 26, 0.08);
}

body.landing-palette .links a,
body.landing-palette .links2 a {
  color: var(--landing-primary) !important;
}

body.landing-palette .links a:hover,
body.landing-palette .links2 a:hover {
  color: var(--landing-secondary) !important;
}

body.landing-palette .chip,
body.landing-palette .filter-pill {
  background: rgba(255, 59, 48, 0.12);
  color: var(--landing-primary);
  border: 1px solid rgba(255, 59, 48, 0.18);
}

body.landing-palette .timeline::before,
body.landing-palette .progress-track {
  background: rgba(255, 59, 48, 0.25) !important;
}

body.landing-palette .timeline-step::after,
body.landing-palette .progress-dot {
  background: var(--landing-gradient) !important;
}

body.landing-palette .nav-signin {
  background: var(--landing-gradient) !important;
  color: #ffffff !important;
  padding: 10px 24px !important;
  border-radius: 999px !important;
  border: none !important;
  font-weight: 600;
  box-shadow: 0 18px 30px rgba(255, 59, 48, 0.25);
}

body.landing-palette .nav-signin:hover {
  box-shadow: 0 20px 36px rgba(255, 59, 48, 0.3);
  transform: translateY(-1px);
}

body.landing-palette .openbtn {
  width: 48px;
  height: 48px;
  border-radius: 16px;
  background: #ffffff !important;
  border: none !important;
  box-shadow: 0 15px 30px rgba(15, 23, 42, 0.12);
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: transparent !important;
  cursor: pointer;
}

body.landing-palette .openbtn::before {
  content: '';
  position: absolute;
  left: 50%;
  width: 22px;
  height: 2px;
  border-radius: 999px;
  background: linear-gradient(90deg, #ff3b30, #ff8700);
  transform: translateX(-50%);
  top: 18px;
  box-shadow: 0 8px 0 rgba(255, 120, 0, 0.95), 0 16px 0 rgba(255, 59, 48, 0.95);
}

body.landing-palette .openbtn:hover {
  box-shadow: 0 18px 32px rgba(15, 23, 42, 0.16);
  transform: translateY(-1px);
}

body.landing-palette .sidebar .closebtn {
  background: #ffffff;
  color: var(--landing-primary);
  width: 42px;
  height: 42px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
  box-shadow: 0 15px 28px rgba(0, 0, 0, 0.25);
}

body.landing-palette .close-report-btn {
  width: 48px;
  height: 48px;
  border-radius: 16px;
  border: none;
  background: #ffffff;
  position: relative;
  box-shadow: 0 15px 30px rgba(15, 23, 42, 0.12);
  cursor: pointer;
}

body.landing-palette .close-report-btn::before,
body.landing-palette .close-report-btn::after {
  content: '';
  position: absolute;
  width: 20px;
  height: 2px;
  background: linear-gradient(135deg, #ff3b30, #ff8700);
  top: 50%;
  left: 50%;
  transform-origin: center;
}

body.landing-palette .close-report-btn::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

body.landing-palette .close-report-btn::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

body.landing-palette .close-report-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 20px 36px rgba(15, 23, 42, 0.16);
}
